use v6.d;
use Test;
use lib 'lib';
use Syndicate::Discovery;
use HTTP::Tiny;

plan 57;

my $d = Syndicate::Discovery.new;

# ===== URL resolution =====
is $d.resolve-url("http://example.com/feed.xml", "http://example.com/"),
    "http://example.com/feed.xml", "absolute URL unchanged";

is $d.resolve-url("/feed.xml", "http://example.com/"),
    "http://example.com/feed.xml", "root-relative URL";

is $d.resolve-url("feed.xml", "http://example.com/blog/"),
    "http://example.com/blog/feed.xml", "relative URL with trailing slash";

is $d.resolve-url("feed.xml", "http://example.com/blog"),
    "http://example.com/feed.xml", "relative URL without trailing slash";

is $d.resolve-url("/rss/", "http://example.com/blog/page"),
    "http://example.com/rss/", "root-relative URL with path base";

is $d.resolve-url("https://other.com/feed.xml", "http://example.com/"),
    "https://other.com/feed.xml", "different origin https URL";

is $d.resolve-url("//other.com/feed.xml", "http://example.com/"),
    "http://other.com/feed.xml", "protocol-relative URL";

# ===== Base URL extraction =====
my $html-with-base = q:to/END/;
<html><head><base href="http://example.com/blog/"></head><body>Hello</body></html>
END
is $d.base-url($html-with-base), "http://example.com/blog/", "extract <base href>";

my $html-no-base = "<html><head></head><body>No base</body></html>";
is $d.base-url($html-no-base), Str, "no <base> tag returns Str";

my $html-base-singlequote = qq|<html><head><base href='http://example.com/'></head></html>|;
is $d.base-url($html-base-singlequote), "http://example.com/", "single-quoted base href";

# ===== Feed discovery from HTML =====
my $html-rss = q:to/END/;
<html>
<head>
  <link rel="alternate" type="application/rss+xml" title="RSS" href="/feed.xml" />
  <link rel="alternate" type="application/atom+xml" title="Atom" href="/atom.xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body><p>Test</p></body>
</html>
END

my @feeds = $d.find-feeds($html-rss, "http://example.com/blog");
is @feeds.elems, 2, "found 2 feed links";
is @feeds[0], "http://example.com/feed.xml", "first feed is RSS";
is @feeds[1], "http://example.com/atom.xml", "second feed is Atom";

# ===== No feeds =====
my $html-no-feeds = q:to/END/;
<html>
<head>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" href="/favicon.ico" />
</head>
<body><p>No feeds here</p></body>
</html>
END

my @empty = $d.find-feeds($html-no-feeds, "http://example.com/");
is @empty.elems, 0, "no feeds found when none present";

# ===== JSON Feed discovery =====
my $html-json = q:to/END/;
<html>
<head>
  <link rel="alternate" type="application/feed+json" title="JSON Feed" href="/feed.json" />
</head>
<body></body>
</html>
END

my @json-feeds = $d.find-feeds($html-json, "http://example.com/");
is @json-feeds.elems, 1, "found JSON feed link";
is @json-feeds[0], "http://example.com/feed.json", "JSON feed URL";

# ===== Multi-line HTML =====
my $html-multiline = q:to/END/;
<html>
<head>
  <link rel="alternate"
        type="application/rss+xml"
        title="RSS"
        href="/blog/feed.xml" />
</head>
<body></body>
</html>
END

my @ml-feeds = $d.find-feeds($html-multiline, "http://example.com/");
is @ml-feeds.elems, 1, "found feed in multi-line HTML";
is @ml-feeds[0], "http://example.com/blog/feed.xml", "multi-line feed URL";

# ===== <base href> affects feed URLs =====
my $html-with-base-and-feeds = q:to/END/;
<html>
<head>
  <base href="http://other.com/sub/">
  <link rel="alternate" type="application/rss+xml" href="feed.xml" />
</head>
<body></body>
</html>
END

my @base-feeds = $d.find-feeds($html-with-base-and-feeds, "http://example.com/");
is @base-feeds.elems, 1, "found feed with base href";
is @base-feeds[0], "http://other.com/sub/feed.xml", "base href affects URL resolution";

# ===== Explicit HTTPS feed link =====
my $html-https = q:to/END/;
<html>
<head>
  <link rel="alternate" type="application/atom+xml" href="https://cdn.example.com/feed.xml" />
</head>
<body></body>
</html>
END

my @https-feeds = $d.find-feeds($html-https, "http://example.com/");
is @https-feeds.elems, 1, "found HTTPS feed link";
is @https-feeds[0], "https://cdn.example.com/feed.xml", "HTTPS feed URL preserved";

# ===== No rel=alternate but matching type =====
my $html-no-rel = q:to/END/;
<html>
<head>
  <link rel="search" type="application/opensearchdescription+xml" href="/search.xml" />
  <link rel="alternate" type="text/html" href="/page.html" />
</head>
<body></body>
</html>
END

my @no-rel-feeds = $d.find-feeds($html-no-rel, "http://example.com/");
is @no-rel-feeds.elems, 0, "no feeds when rel is not alternate";

# ===== Alternative attribute quoting =====
my $html-alt-quotes = q:to/END/;
<html>
<head>
  <link rel='alternate' type='application/rss+xml' href='/rss.xml' />
</head>
<body></body>
</html>
END

my @alt-q-feeds = $d.find-feeds($html-alt-quotes, "http://example.com/");
is @alt-q-feeds.elems, 1, "single-quoted attributes work";
is @alt-q-feeds[0], "http://example.com/rss.xml", "single-quoted href";

# ===== SSRF protection: IPv4 short forms, mapped IPv6, private ranges =====
my constant $OK-RSS = q:to/END/;
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>t</title><link>http://e.com</link><description>d</description></channel></rss>
END

class FakeUA is HTTP::Tiny {
    has Str $.ct = "application/rss+xml";
    method get($url) {
        %( :status(200), :success(True), :reason("OK"),
           :headers(%(:content-type($!ct))),
           :content($OK-RSS.encode) )
    }
}

sub fetch-result(Str $url, Str $ct = "application/rss+xml") {
    my $d = Syndicate::Discovery.new(:ua(FakeUA.new(:ct($ct))));
    my $ok = False;
    try {
        my $feed = $d.fetch($url);
        $ok = $feed.defined;
    }
    $ok
}

for <
    http://127.0.0.1/feed
    http://127.1/feed
    http://0x7f.1/feed
    http://0177.0.0.1/feed
    http://0.0.0.0/feed
    http://10.0.0.1/feed
    http://192.168.1.1/feed
    http://172.16.0.1/feed
    http://169.254.0.1/feed
    http://2130706433/feed
    http://[::1]/feed
    http://[::ffff:127.0.0.1]/feed
    http://[::ffff:2130706433]/feed
    http://[::ffff:7f00:1]/feed
    http://[::ffff:10.0.0.1]/feed
> -> $u {
    ok !fetch-result($u), "SSRF blocked: $u";
}

for <
    http://8.8.8.8/feed
    http://[::ffff:8.8.8.8]/feed
    http://example.com/feed
> -> $u {
    ok fetch-result($u), "SSRF allowed: $u";
}

# ===== Content-Type matching =====
ok fetch-result("http://example.com/feed", "application/rss+xml; charset=utf-8"),
    "Content-Type with charset param accepted";
ok fetch-result("http://example.com/feed", "text/xml"),
    "text/xml accepted";
ok !fetch-result("http://example.com/feed", "text/html"),
    "text/html rejected";

# ===== Bare attributes in <link> tags =====
my $html-bare-href = q:to/END/;
<html><head>
  <link rel="alternate" href type="application/rss+xml" />
  <link rel="alternate" type="application/rss+xml" href="/ok.xml" />
</head><body></body></html>
END
my @bare-href-feeds = $d.find-feeds($html-bare-href, "http://example.com/");
is @bare-href-feeds.elems, 1, "bare href attribute skipped without crash";
is @bare-href-feeds[0], "http://example.com/ok.xml", "valid link found alongside bare href";

my $html-bare-rel = q:to/END/;
<html><head><link rel href="/f.xml" type="application/rss+xml" /></head><body></body></html>
END
my @bare-rel-feeds = $d.find-feeds($html-bare-rel, "http://example.com/");
is @bare-rel-feeds.elems, 0, "bare rel attribute does not match alternate";

# ===== IPv4-compatible/embedded IPv6 =====
for <
    http://[::127.0.0.1]/feed
    http://[0:0:0:0:0:0:127.0.0.1]/feed
> -> $u {
    ok !fetch-result($u), "SSRF blocked: $u";
}

for <
    http://[::123.0.0.1]/feed
    http://[2001:db8::1.2.3.4]/feed
> -> $u {
    ok fetch-result($u), "SSRF allowed: $u";
}

# ===== Response size caps =====
class FakeUABody is HTTP::Tiny {
    has $.resp;
    method get($url) { $!resp }
}

my $small-rss = $OK-RSS.encode;
my $disc-cl = Syndicate::Discovery.new(:ua(FakeUABody.new(resp => %(
    :status(200), :success(True), :reason("OK"), :content($small-rss),
    :headers(%(:content-type("application/rss+xml"), :content-length("999999999")))))));
my $cl-ok = False;
try { $disc-cl.fetch("http://example.com/feed"); $cl-ok = True; }
ok !$cl-ok, "Content-Length over MAX-FEED-SIZE rejected";

my $big-body = ("x" x 11_000_000).encode;
my $disc-body = Syndicate::Discovery.new(:ua(FakeUABody.new(resp => %(
    :status(200), :success(True), :reason("OK"), :content($big-body),
    :headers(%(:content-type("application/rss+xml")))))));
my $body-ok = False;
try { $disc-body.fetch("http://example.com/feed"); $body-ok = True; }
ok !$body-ok, "body over MAX-FEED-SIZE rejected";

# ===== Custom duck-typed user agent =====
class DuckUA {
    has $.resp;
    method get($url) { $!resp }
}
my $disc-duck = Syndicate::Discovery.new(:ua(DuckUA.new(resp => %(
    :status(200), :success(True), :reason("OK"), :content($small-rss),
    :headers(%(:content-type("application/rss+xml")))))));
my $duck-ok = False;
my $duck-title = "";
try { $duck-title = $disc-duck.fetch("http://example.com/feed").title; $duck-ok = True; }
ok $duck-ok, "custom duck-typed ua works";
is $duck-title, "t", "duck-typed ua fetch returns feed";

done-testing;
